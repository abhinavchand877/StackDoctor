# ========================================================
# StackDoctor Comprehensive .gitignore
# ========================================================

# Python Caches & Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
.Python
env/
venv/
.venv/
build/
backend/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage/
htmlcov/

# Database & Local Dumps
*.db
*.sqlite
*.sqlite3
*.dump
*.sql
!sample_projects/**

# Node / Frontend Build Output
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# Secrets, Keys, Certificates & Credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pfx
*.p12
*.crt
credentials*
*credentials*.json
*service-account*.json
*service_account*.json
gcp-credentials*.json
!.env.example
!package.json
!package-lock.json

# Logs & Temporary Files
logs/
*.log
tmp/
backend/tmp/
uploads/
backend/uploads/
reports/
generated_reports/
*.zip.tmp
.cache/
.agents/

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

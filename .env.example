# ========================================================
# StackDoctor Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# NEVER commit the active .env file to version control.
# ========================================================

# Flask Backend Security Keys
SECRET_KEY=replace-with-a-random-secret-key-32-chars
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-key-32-chars
JWT_EXPIRATION_HOURS=24
FLASK_ENV=development
DEBUG=True
PORT=5000
FRONTEND_PORT=8080

# Database Configuration (MySQL)
DATABASE_URL=mysql+pymysql://stack_user:stack_secure_pass_2026@localhost:3306/stackdoctor_db
USE_SQLITE=false

# Docker MySQL Container Variables
MYSQL_ROOT_PASSWORD=root_secure_pass_2026
MYSQL_DATABASE=stackdoctor_db
MYSQL_USER=stack_user
MYSQL_PASSWORD=stack_secure_pass_2026

# Upload & Extraction Limits
MAX_UPLOAD_SIZE_BYTES=52428800        # 50 MB
MAX_EXTRACTED_SIZE_BYTES=157286400    # 150 MB
MAX_ARCHIVE_ENTRIES=3000
MAX_INSPECT_FILE_SIZE_BYTES=2097152   # 2 MB

# Celery & Redis Background Worker Queue
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
ASYNC_SCANS_ENABLED=false

# Frontend Environment Variables
VITE_BACKEND_URL=http://localhost:5000
